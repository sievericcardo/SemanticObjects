class A()
models "a ast:C .";
    Unit printVal()
        print("A");
    end
end

class B extends A()
models "a ast:A .";
classifies "ASK WHERE { %this smol:implements prog:B }";
retrieves "SELECT ?v WHERE { ?v smol:doesNotExist ?v }";
    override Unit printVal()
        print("B");
    end
end

class C extends A()
models "a ast:B .";
classifies "<smol:links> some <ast:A>";
retrieves "SELECT ?v WHERE { ?v smol:doesNotExist ?v }";
    override Unit printVal()
        print("C");
    end
end


main
    A a = new B();
    adapt(a);
    breakpoint;
    a.printVal();
end
