    Unit adaptAddConstraint()
        List<Constraint> constraints = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id
WHERE {
    ?constraint a odrl:Constraint ;
        pol:identifier ?id .
    FILTER NOT EXISTS {
        ?obj a prog:Constraint ;
            prog:Constraint_id ?id .
    }
}
        ");

        if constraints != null then
            print("RECONFIG> New Constraint(s) detected: repairing the model");

            while constraints != null do
                Constraint newConstraint = constraints.content;
                
                List<Constraint> lx = constraints;
                constraints = constraints.next;
                print("RECONFIG> New constraint detected: ");
                print("          Constraint Id: " ++ newConstraint.id);

                newConstraint.setRightOperands();

                destroy(lx);
            end

            print("RECONFIG> Constraint(s) added");
        end
    end

    Unit adaptAddAsset()
        List<Asset> assets = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id ?attributeName
WHERE {
    ?asset a odrl:Asset ;
        pol:identifier ?id ;
        odrl:label ?attributeName .
    FILTER NOT EXISTS {
        ?obj a prog:Asset ;
            prog:Asset_id ?id .
    }
}
        ");

        if assets != null then
            print("RECONFIG> New Asset(s) detected: repairing the model");

            while assets != null do
                Asset newAsset = assets.content;
                
                List<Asset> lx = assets;
                assets = assets.next;
                print("RECONFIG> New asset detected: ");
                print("          Asset Id: " ++ newAsset.id);

                destroy(lx);
            end

            print("RECONFIG> Asset(s) added");
        end
    end

    Unit adaptAddAssetCollection()
        List<AssetCollection> acs = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id
WHERE {
    ?ac a odrl:AssetCollection ;
        pol:identifier ?id .
    FILTER NOT EXISTS {
        ?obj a prog:AssetCollection ;
            prog:AssetCollection_id ?id .
    }
}
        ");

        if acs != null then
            print("RECONFIG> New Asset Collection(s) detected: repairing the model");

            while acs != null do
                AssetCollection newAssetCollection = acs.content;
                
                List<AssetCollection> lx = acs;
                acs = acs.next;
                print("RECONFIG> New asset collection detected: ");
                print("          Asset Collection Id: " ++ newAssetCollection.id);

                newAssetCollection.setAssets();

                destroy(lx);
            end

            print("RECONFIG> Asset Collection(s) added");
        end
    end

    Unit adaptAddSotw()
        List<Sotw> sotws = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?id ?timestamp
WHERE {
    ?sotw a pol:Sotw ;
        pol:identifier ?id ;
        pol:timestamp ?ts .
    ?ts dct:issued ?timestamp .
    FILTER NOT EXISTS {
        ?obj a prog:Sotw ;
            prog:Sotw_timestamp ?timestamp .
    }
}
        ");

        if sotws != null then
            print("RECONFIG> New Sotw(s) detected: repairing the model");

            while sotws != null do
                Sotw newSotw = sotws.content;
                
                List<Sotw> lx = sotws;
                sotws = sotws.next;
                print("RECONFIG> New sotw detected: ");
                print("          Sotw Id: " ++ newSotw.id);

                newSotw.setAssetCollections();

                destroy(lx);
            end

            print("RECONFIG> Sotw(s) added");
        end
    end

    override Unit adaptAddition()
        print("RECONFIG> Adapting addition of Policies for ODRL");
        this.adaptAddDataSubject();
        this.adaptAddDataController();
        this.adaptAddAction();
        this.adaptAddOperand();
        this.adaptAddConstraint();
        this.adaptAddAsset();
        this.adaptAddAssetCollection();
        this.adaptAddSotw();
        print("RECONFIG> Adapting addition of Policies DONE for ODRL");
    end

    Unit adaptRemoveDataSubject()
        List<DataSubject> dss = access("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?obj
WHERE {
    ?obj a prog:DataSubject ;
        prog:DataSubject_id ?id .
    FILTER NOT EXISTS {
        ?ds a odrl:DataSubject ;
            pol:identifier ?id .
    }
}
        ");

        if dss != null then
            print("RECONFIG> Misconfigured Data Subject(s) detected: repairing the model");
            while dss != null do
                DataSubject wrongDataSubject = dss.content;
                List<DataSubject> lx = dss;
                dss = dss.next;
                destroy(lx);

                print("RECONFIG> Misconfigured data subject to remove: ");
                print("          Data Subject Id: " ++ wrongDataSubject.id);

                destroy(wrongDataSubject);
            end


            print("RECONFIG> Data Subject(s) removed");
        end
    end

