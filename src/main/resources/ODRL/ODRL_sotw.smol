    override Unit adaptRemoval()
        print("RECONFIG> Adapting removal of Policies for ODRL");
        this.adaptRemoveDataSubject();
        this.adaptRemoveDataController();
        this.adaptRemoveAction();
        this.adaptRemoveOperand();
        this.adaptRemoveConstraint();
        this.adaptRemoveAsset();
        this.adaptRemoveAssetCollection();
        this.adaptRemoveSotw();
        print("RECONFIG> Adapting removal of Policies DONE for ODRL");
    end

    override Unit adaptDefect()
