class SotwModel extends ODRLModel()
    Unit adaptAddDataSubject()
        List<DataSubject> dss = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id
WHERE {
    ?ds a odrl:DataSubject ;
        pol:identifier ?id .
    FILTER NOT EXISTS {
        ?obj a prog:DataSubject ;
            prog:DataSubject_id ?id .
    }
}
        ");

        if dss != null then
            print("RECONFIG> New Data Subject(s) detected: repairing the model");

            while dss != null do
                DataSubject newDataSubject = dss.content;
                
                List<DataSubject> lx = dss;
                dss = dss.next;
                print("RECONFIG> New data subject detected: ");
                print("          Data Subject Id: " ++ newDataSubject.id);

                destroy(lx);
            end

            print("RECONFIG> Data Subject(s) added");
        end
    end

    Unit adaptAddDataController()
        List<DataController> dcs = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id
WHERE {
    ?dc a odrl:DataController ;
        pol:identifier ?id .
    FILTER NOT EXISTS {
        ?obj a prog:DataController ;
            prog:DataController_id ?id .
    }
}
        ");

        if dcs != null then
            print("RECONFIG> New Data Controller(s) detected: repairing the model");

            while dcs != null do
                DataController newDataController = dcs.content;
                
                List<DataController> lx = dcs;
                dcs = dcs.next;
                print("RECONFIG> New data controller detected: ");
                print("          Data Controller Id: " ++ newDataController.id);

                destroy(lx);
            end

            print("RECONFIG> Data Controller(s) added");
        end
    end

    Unit adaptAddAction()
        List<Action> actions = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>

SELECT ?type
WHERE {
    ?action a odrl:Action ;
        odrl:label ?type .
    FILTER NOT EXISTS {
        ?obj a prog:Action ;
            prog:Action_type ?type .
    }
}
        ");

        if actions != null then
            print("RECONFIG> New Action(s) detected: repairing the model");

            while actions != null do
                Action newAction = actions.content;
                
                List<Action> lx = actions;
                actions = actions.next;
                print("RECONFIG> New action detected: ");
                print("          Action Type: " ++ newAction.type);

                destroy(lx);
            end

            print("RECONFIG> Action(s) added");
        end
    end

    Unit adaptAddOperand()
        List<Operand> purposes = construct("
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pol: <http://www.smolang.org/greenhouseDT-policy#>

SELECT ?id
WHERE {
    ?purpose a odrl:Purpose ;
