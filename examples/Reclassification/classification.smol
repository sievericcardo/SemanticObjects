class A()
models "a ast:C .";
    Unit printVal()
        print("A");
    end
end

class B extends A()
models "a ast:A .";
classifies "ASK WHERE {
  %this smol:links [a ast:B] .
}";
    override Unit printVal()
        print("B");
    end
end

class C extends A()
models "a ast:B .";
classifies "<smol:links> some <ast:A>";
    override Unit printVal()
        print("C");
    end
end


main
    A a = new B();
    classify(a);
    breakpoint;
    a.printVal();
end
